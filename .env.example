# Copier en .env sur le mini-PC. Ne jamais publier la clé de projet.
# Aucun accès cloud : seules les adresses IP loopback sont acceptées.
REFUGE_PORT=8099
# Facultatif, acces depuis les appareils d'un reseau local de confiance.
# Autorise uniquement cette adresse IPv4 privee comme adresse du serveur.
# REFUGE_LAN_HOST=192.168.178.50
REFUGE_AI_PROVIDER=ollama
REFUGE_AI_BASE_URL=http://127.0.0.1:11479/v1
REFUGE_AI_MODEL=qwen3:4b-instruct-2507-q4_K_M
# CPU lent : augmenter si la lecture des references prend plus de 3 minutes.
# Delai total par reponse en millisecondes, entre 30000 et 900000.
REFUGE_AI_TIMEOUT_MS=180000
REFUGE_AI_KEY=

# Facultatif Windows : port du récepteur GPS USB détecté, jamais utilisé pour la radio.
# REFUGE_GPS_PORT=COM4

# Pour réutiliser Nexus Local Studio installé sur le MEME mini-PC :
# REFUGE_AI_PROVIDER=studio
# REFUGE_AI_BASE_URL=http://127.0.0.1:8090/local-studio/v1
# REFUGE_AI_MODEL=local-chat-fast
# REFUGE_AI_KEY=cle-projet-autorisee-pour-chat-et-local-chat-fast
# Le site public https://2ki.space est un accès distant, pas une dépendance hors ligne.

# Facultatif : accès distant distinct, uniquement si choisi dans l'interface.
# Créer une clé de projet limitée au chat et au modèle choisi dans Local Studio.
# REFUGE_REMOTE_STUDIO_KEY=
# REFUGE_REMOTE_STUDIO_MODEL=local-chat-fast
