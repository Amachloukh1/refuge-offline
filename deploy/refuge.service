[Unit]
Description=REFUGE offline preparedness interface
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/surviver
ExecStart=/usr/bin/env node --env-file-if-exists=.env server/index.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true

[Install]
WantedBy=default.target
